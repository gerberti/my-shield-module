/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
	    col-gpios
	    	= <&gpio0 28 GPIO_ACTIVE_HIGH>
	    	, <&gpio0 29 GPIO_ACTIVE_HIGH>
	    	;
     //   row-gpios
     //       = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
     //       , <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
     //       ;
	 //   col-gpios
	 //   	= <&xiao_d 2 GPIO_ACTIVE_HIGH>
	 //   	, <&xiao_d 3 GPIO_ACTIVE_HIGH>
	 //   	;
    };
};

/ {
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <2>;
        map = <
        //  LKey 1 |LKey 2       RKey 1 |RKey 2
            RC(0,0) RC(0,1)      RC(0,2) RC(0,3)
        //  LKey 3 |LKey 4     RKey 3 |RKey 4
            RC(1,0) RC(1,1)      RC(1,2) RC(1,3)
        >;
    };
};

/ {
    physical_layout0: physical_layout_0 { // First physical layout, use different naming for other layouts
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>; // Label of the kscan node, optional if all layouts use the same
        transform = <&default_transform>; // Label of the matrix transform for this layout
    };
};

&gpio0 {
    fastbatcharge: fast-battery-charge {
        gpio-hog;
        gpios = <13 GPIO_ACTIVE_HIGH>;
        output-low;
        line-name = "Fast Battery Charge";
    };
};

&xiao_spi {
	compatible = "nordic,nrf-spi";
	status = "okay";

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";

		/* SPI */
		reg = <0>; /* ignored, but necessary for SPI bindings */
		spi-max-frequency = <4000000>;

		/* WS2812 */
		chain-length = <3>; /* arbitrary; change at will */
		color-mapping = <LED_COLOR_ID_GREEN
				         LED_COLOR_ID_RED
				         LED_COLOR_ID_BLUE>;
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
	};
};

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
        // Other chosen items
		zmk,underglow = &led_strip;
    };
};


